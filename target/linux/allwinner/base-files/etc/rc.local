# Put your custom commands here that should be executed once
# the system init finished. By default this file does nothing.

# Fix: AIC8800 USB WiFi may not be ready at boot (USB enumerate / fw load
# is slow, hostapd can start before the phy exists and then is skipped).
# Check every 10s; once a phy appears, reload wireless (max 5 tries).
(
	i=0
	while [ $i -lt 5 ]; do
		sleep 10
		i=$((i+1))
		if ls /sys/class/ieee80211/ 2>/dev/null | grep -q phy; then
			wifi reload 2>/dev/null
			break
		fi
	done
) &

exit 0
